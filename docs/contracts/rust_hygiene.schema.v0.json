{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wavenumber-eng/wn-dev-std/docs/contracts/rust_hygiene.schema.v0.json",
  "title": "Rust structural-hygiene TOML contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "limits", "paths"],
  "properties": {
    "schema": { "const": 1 },
    "mode": { "enum": ["strict", "ratchet"] },
    "baseline": { "type": "string" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_parameters",
        "max_function_lines",
        "max_test_function_lines",
        "max_file_lines",
        "max_cyclomatic_complexity",
        "max_nesting"
      ],
      "properties": {
        "max_parameters": { "type": "integer", "minimum": 1, "maximum": 7 },
        "max_function_lines": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_test_function_lines": { "type": "integer", "minimum": 1, "maximum": 150 },
        "max_file_lines": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "max_cyclomatic_complexity": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_nesting": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_roots", "exclude_parts"],
      "properties": {
        "source_roots": { "$ref": "#/$defs/nonEmptyStringArray" },
        "exclude_parts": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "item", "rule", "max_value", "reason", "review_trigger"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "item": { "type": "string", "minLength": 1 },
          "rule": {
            "enum": [
              "max_parameters",
              "max_function_lines",
              "max_test_function_lines",
              "max_file_lines",
              "max_cyclomatic_complexity",
              "max_nesting"
            ]
          },
          "max_value": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "review_trigger": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "ratchet" } } },
      "then": { "required": ["baseline"] }
    },
    {
      "if": { "properties": { "mode": { "const": "strict" } } },
      "then": { "not": { "required": ["baseline"] } }
    }
  ],
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
